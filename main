def toggle_pause():
    global paused, pause_started, last_activity

    if not paused:
        paused = True
        pause_started = time.monotonic()
        print("Paused")
    else:
        paused = False

        if pause_started is not None:
            last_activity += time.monotonic() - pause_started

        pause_started = None
        print("Unpaused")
