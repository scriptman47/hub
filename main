import pyautogui
import pydirectinput
import time
import keyboard
import pygetwindow as gw
import os

# SETTINGS
stopButton = "F4"
pauseButton = "F5"
failsafeTimer = 18
pulseBtn = 'q'

pydirectinput.PAUSE = 0.02

# STATE
paused = False
loaded = False
onRBbutton = False
load_timer = None
pause_started = None

# COLORS
target_color1 = (255, 50, 50)
target_color2 = (52, 255, 109)
target_color3 = (255, 50, 50)
layout_color = (49, 48, 48)

def stop():
    print("Stopping script")
    os._exit(0)

def press_keys(*keys):
    for key in keys:
        if key == '\\':
            time.sleep(0.15)
            pydirectinput.press(key)
            time.sleep(0.15)
        else:
            pydirectinput.press(key)

def wait_for_pixel(x, y, color, timeout=30, tolerance=10):
    start = time.time()

    while time.time() - start < timeout:
        if paused:
            time.sleep(0.1)
            continue

        if pyautogui.pixelMatchesColor(
            x, y, color, tolerance=tolerance
        ):
            return True

        time.sleep(0.1)

    return False

def toggle_pause():
    global paused, pause_started, load_timer

    if not paused:
        paused = True
        pause_started = time.time()
        print("Paused")
    else:
        paused = False

        if pause_started is not None and load_timer is not None:
            load_timer += time.time() - pause_started

        pause_started = None
        print("Unpaused")

def load_setup():
    global loaded, onRBbutton, load_timer

    print("Load menu found")
    press_keys('\\', '\\')

    if not wait_for_pixel(1209, 445, layout_color):
        print("Lay1 timeout")
        return False

    print("Lay1 detected")
    press_keys('enter')
    time.sleep(.1)

    if not wait_for_pixel(1190, 611, layout_color):
        print("Lay2 timeout")
        return False

    print("Lay2 detected")
    time.sleep(.1)
    press_keys('left', 'down', 'right')
    check = pyautogui.pixel(1200, 461)
    if check == (255, 255, 255):
        press_keys('down', 'left', 'right')
    press_keys('enter', '\\')
    time.sleep(0.1)
    press_keys('m', '\\', 'down')

    loaded = True
    onRBbutton = True
    load_timer = time.time()

    print("Setup loaded - watchdog started")
    return True

def failsafe_load():
    global loaded, onRBbutton, load_timer, recovering

    recovering = True
    load_timer = None

    print("LOAD TIMED OUT!")
    press_keys('l')
    press_keys('\\')
    try:
        if pyautogui.pixelMatchesColor(1232, 264, target_color3, tolerance=10):
            print("load menu found")

            if not wait_for_pixel(1209, 445, layout_color):
                print("Lay1 timeout")
                return False

            print("Lay1 detected")
            press_keys('enter')
            time.sleep(.1)

            if not wait_for_pixel(1190, 611, layout_color):
                print("Lay2 timeout")
                return False

            print("Lay2 detected")
            time.sleep(.1)
            press_keys('left', 'down', 'right')
            check = pyautogui.pixel(1200, 461)
            if check == (255, 255, 255):
                press_keys('down', 'left', 'right')
            press_keys('enter', '\\')
            time.sleep(0.1)
            press_keys('m', '\\', 'down', pulseBtn)

            print("Failsafe setup completed")

            loaded = True
            onRBbutton = True

            return True

        else:
            print("Load menu not found")
            return False

    finally:
        recovering = False
        load_timer = time.time()

# HOTKEYS
keyboard.add_hotkey(pauseButton, toggle_pause)
keyboard.add_hotkey(stopButton, stop)

# FIND ROBLOX
windows = gw.getWindowsWithTitle('Roblox')

if not windows:
    print("Roblox window not found")
    raise SystemExit

win = windows[0]
win.activate()

print("Started")
time.sleep(1)

# MAIN LOOP
while True:

    if paused:
        time.sleep(0.1)
        continue

    # BACKGROUND FAILSAFE
    if load_timer is not None:
        elapsed = time.time() - load_timer

        if elapsed >= failsafeTimer:
            print("Load timed out!")
            failsafe_load()
            time.sleep(0.1)
            continue

    # REBIRTH MENU
    if pyautogui.pixelMatchesColor(
        1349, 270, target_color1, tolerance=10
    ):

        if not onRBbutton:
            print("Rebirth menu found")
            press_keys('\\', 'down')
            time.sleep(0.1)

            colorb = pyautogui.pixel(1030, 313)

            if colorb == (255, 255, 255):
                pydirectinput.press('down')

            onRBbutton = True

    elif loaded:
        pydirectinput.press('m')

    else:
        pydirectinput.press('m')

    # REBIRTH
    if pyautogui.pixelMatchesColor(
        910, 419, target_color2, tolerance=10
    ):

        if onRBbutton:

            print("Enough money detected")

            # Stop watchdog while rebirthing
            load_timer = None

            press_keys('enter', 'left', 'enter', '\\')

            loaded = False
            onRBbutton = False

            time.sleep(.1)
            press_keys('l')

        # WAIT FOR LOADING INDICATOR
        while pyautogui.pixelMatchesColor(
            20, 1004, (22, 50, 26), tolerance=10
        ):
            if paused:
                time.sleep(0.1)
                continue

        # NORMAL SETUP LOADING
        if pyautogui.pixelMatchesColor(
            1232, 264, target_color3, tolerance=10
        ):
            load_setup()

    time.sleep(0.1)
