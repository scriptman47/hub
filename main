import pyautogui
import pydirectinput
import time
import keyboard
import pygetwindow as gw
import os
import autoit

# SETTINGS
stopButton = "F4"
pauseButton = "F5"
failsafeTimer = 13
last_activity = time.monotonic()
recovering = False
pulseBtn = 'q'

pydirectinput.PAUSE = 0.01

# STATE
paused = False
loaded = False
onRBbutton = False
load_timer = None
pause_started = None

# COLORS
target_color1 = (255, 50, 50)
target_color2 = (52, 255, 109)
target_color3 = (255, 50, 50)
target_color4 = (255, 255, 255)
layout_color = (49, 48, 48)

def stop():
    print("Stopping script")
    os._exit(0)

def press_keys(*keys):
    for key in keys:
        if key == '\\':
            time.sleep(0.15)
            pydirectinput.press(key)
            time.sleep(0.15)
        else:
            pydirectinput.press(key)

def wait_for_pixel(x, y, color, timeout=30, tolerance=10):
    start = time.time()
    while time.time() - start < timeout:
        if paused:
            time.sleep(0.1)
            continue
        if pyautogui.pixelMatchesColor(
            x, y, color, tolerance=tolerance
        ):
            return True
        time.sleep(0.1)
    return False

def toggle_pause():
    global paused, pause_started, last_activity
    if not paused:
        paused = True
        pause_started = time.monotonic()
        print("paused")
    else:
        paused = False
        if pause_started is not None:
            last_activity += time.monotonic() - pause_started
        pause_started = None
        print("unpaused")
        reset_watchdog()

def load_setup():
    global loaded, onRBbutton, load_timer
    if not wait_for_pixel(1232, 264, target_color3):
        print("layout menu timeout")
        return False
    print("Load menu found")
    time.sleep(.1)
    autoit.mouse_move(1209, 445, 1)
    while pyautogui.pixelMatchesColor(
            20, 1004, (22, 50, 26), tolerance=10
    ):
        if paused:
            time.sleep(0.1)
            continue
            autoit.mouse_move(1209, 446, 1)
    autoit.mouse_click("left", 1209, 446, 1, 1)
    time.sleep(.1)
    autoit.mouse_move(1190, 611, 1)
    if not wait_for_pixel(1190, 611, layout_color):
        print("layout2 timeout")
        return False
    autoit.mouse_move(1190, 612, 1)
    autoit.mouse_click("left", 1190, 612, 1, 1)
    press_keys('m', '\\', 'down')
    loaded = True
    onRBbutton = True
    load_timer = time.time()
    print("loaded")
    return True


def reset_watchdog():
    global last_activity
    last_activity = time.monotonic()


def watchdog_expired():
    if paused or recovering:
        return False
    return time.monotonic() - last_activity >= failsafeTimer


def failsafe_load():
    global loaded, onRBbutton, load_timer, recovering
    recovering = True
    load_timer = None
    print("timed out")
    press_keys('l')
    try:
        autoit.mouse_move(1209, 445, 1)
        while pyautogui.pixelMatchesColor(
                20, 1004, (22, 50, 26), tolerance=10
        ):
            if paused:
                time.sleep(0.1)
                continue
                autoit.mouse_move(1209, 446, 1)
        autoit.mouse_click("left", 1209, 446, 1, 1)
        time.sleep(.1)
        autoit.mouse_move(1190, 611, 1)
        if not wait_for_pixel(1190, 611, layout_color):
            print("layout2 timeout")
            return False
        autoit.mouse_move(1190, 612, 1)
        autoit.mouse_click("left", 1190, 612, 1, 1)
        press_keys('m', '\\', 'down')
        loaded = True
        onRBbutton = True
        load_timer = time.time()
        print("loaded")
    finally:
        recovering = False
        load_timer = time.time()
    reset_watchdog()

# HOTKEYS
keyboard.add_hotkey(pauseButton, toggle_pause)
keyboard.add_hotkey(stopButton, stop)

# FIND ROBLOX
windows = gw.getWindowsWithTitle('Roblox')

if not windows:
    print("Roblox window not found")
    raise SystemExit

win = windows[0]
win.activate()

print("started")
time.sleep(1)

# MAIN LOOP
while True:
    if paused:
        time.sleep(0.1)
        continue
    if recovering:
        time.sleep(0.1)
        continue
    # GLOBAL WATCHDOG
    if watchdog_expired():
        reset_watchdog()
    # BACKGROUND FAILSAFE
    if load_timer is not None:
        elapsed = time.time() - load_timer
        if elapsed >= failsafeTimer:
            print("timed out")
            failsafe_load()
            time.sleep(0.1)
            continue
    # REBIRTH MENU
    if pyautogui.pixelMatchesColor(
        1349, 270, target_color1, tolerance=10
    ):
        if not onRBbutton:
            press_keys('\\', 'down')
            time.sleep(0.1)
            colorb = pyautogui.pixel(1030, 313)
            if colorb == (255, 255, 255):
                pydirectinput.press('down')
            onRBbutton = True
    elif loaded and not recovering:
        pydirectinput.press('m')
    elif not recovering:
        pydirectinput.press('m')
    # REBIRTH
    if pyautogui.pixelMatchesColor(
        910, 419, target_color2, tolerance=10
    ):
        if onRBbutton:
            # Stop watchdog while rebirthing
            load_timer = None
            press_keys('enter', 'left', 'enter', 'enter', '\\')
            loaded = False
            onRBbutton = False
            time.sleep(.1)
            press_keys('l')
        # NORMAL SETUP LOADING
            load_setup()
            reset_watchdog()

    time.sleep(0.1)
